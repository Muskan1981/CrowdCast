# CrowdCast environment. Copy to .env and change every value marked CHANGE ME.
#   cp .env.example .env
# Compose reads this file automatically. Every variable the stack uses is listed here.

# ---- Secrets (CHANGE ME) -----------------------------------------------------
# JWT signing key. Must be at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-string-32chars
# Admin key for /api/v1/admin/* (sent as the X-Admin-Key header).
ADMIN_API_KEY=change-me-admin-key
# Grafana admin login. The password is required; compose will not start without it.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=crowdcast
# Host port for Postgres. Set to a different port if 5432 is already in use.
POSTGRES_PORT=5432

# ---- Redis -------------------------------------------------------------------
REDIS_PORT=6379

# ---- Host ports --------------------------------------------------------------
# Public entry point (nginx). The app is at http://localhost:8080.
APP_PORT=8080
# Grafana: http://localhost:3000
GRAFANA_PORT=3000
# Prometheus: http://localhost:9090
PROMETHEUS_PORT=9090
# Alertmanager (profile `alerts`): http://localhost:9093
ALERTMANAGER_PORT=9093

# ---- API tuning (applied to every instance) ----------------------------------
ALLOWED_ORIGINS=*
WS_MAX_CONNS=10000
REACTION_BATCH_MS=250
CHAT_RATE_LIMIT=1500ms
LOG_LEVEL=info

# ---- Load generator (profile `load`, used by `make loadgen`) -------------------
LOADGEN_SCENARIO=ramp
LOADGEN_USERS=500
LOADGEN_DURATION=2m
LOADGEN_EVENT=cc-0826

# ---- Dev only (docker-compose.override.yml) -----------------------------------
# Delve/debug port exposed by the dev container for api-01.
API_DEBUG_PORT=2345

# ---- Not read by compose, documented for reference ---------------------------
# Instance identity is set per service in docker-compose.yml, not here:
#   INSTANCE_ID, INSTANCE_ZONE, INSTANCE_WEIGHT must match the expected fleet.
# HTTP_ADDR, REDIS_URL, DATABASE_URL, PROMETHEUS_URL, GRAFANA_URL are built per service.
